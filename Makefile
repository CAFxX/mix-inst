# RV64 `mix` instruction research — build and test entry point.
#
#   make all    regenerate all generated artifacts, run the full test suite,
#               and fail if any committed generated file drifts from what
#               the build produces (CI enforces this via git diff).
#   make test   run the test suite only.
#   make vectors
#               regenerate rtl/vectors.hex (deterministic, seed 0xBEEF).
#
# Convention (standing order): every file committed to this repo that is
# produced by a build step MUST be regenerated by `make all`, and CI fails
# if the committed copy differs from the freshly built one. When you add a
# new generated file, add its generator here AND list it in check-drift.

PYTHON ?= python3

GENERATED = rtl/vectors.hex

.PHONY: all test vectors check-drift clean

all: vectors test check-drift

vectors:
	$(PYTHON) rtl/gen_vectors.py

test:
	$(PYTHON) tests_part1.py
	$(PYTHON) tests_part2.py
	$(PYTHON) tests_part3.py
	$(PYTHON) tests_part4.py
	$(PYTHON) tests_part5.py
	$(PYTHON) tests_adversarial.py
	$(PYTHON) tests_final.py

# Fail if any generated file differs from the committed version.
check-drift:
	git diff --exit-code -- $(GENERATED)

clean:
	rm -f $(GENERATED)
