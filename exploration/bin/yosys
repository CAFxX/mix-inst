#!/bin/bash
# yosys shim for the exploration synth flow (infrastructure repair, 2026-10-01).
#
# PROBLEM: the pre-restart environment's yosys accepted `abc -fast -genlib`,
# but the yosys surviving the restart (conda-forge 0.69) dropped the `-fast`
# option from the `abc` pass -> run_synth.py fails with
# "Unknown option or option in arguments".
#
# FIX: rewrite `abc -fast -genlib F` to the EXACT historical fast script.
# From yosys 0.34 passes/techmap/abc.cc (verified against the 0.34 sources):
#     ABC_FAST_COMMAND_LIB = "strash; dretime; map {D}"
# with no -D given, {D} is empty, i.e. the ABC script is `strash; dretime; map`.
# yosys >= 0.4x supports `-script +<cmds>` where commas become blanks, so:
#     abc -fast -genlib F  ->  abc -genlib F -script +strash;,dretime;,map
# The .ys files generated by run_synth.py are NOT modified; only the yosys
# invocation is shimmed. Validation: the mul64 reference re-measured through
# this shim must come out at crit ~= 49.2 (the brief's twice-measured value).
REAL=/home/hatch/tools/micromamba-root/envs/sky130/bin/yosys
newargs=()
prev=""
for a in "$@"; do
  if [ "$prev" = "-s" ] && [ -f "$a" ]; then
    tmp=$(mktemp /tmp/ys_shim_XXXXXX.ys)
    sed -e 's/abc -fast -genlib \([^ ]*\)/abc -genlib \1 -script +strash;,dretime;,map/' "$a" > "$tmp"
    if ! grep -q -- "-script +strash" "$tmp"; then
      echo "yosys-shim: no 'abc -fast -genlib' line found in $a; passing through unmodified" >&2
      rm -f "$tmp"
      newargs+=("$a")
    else
      newargs+=("$tmp")
    fi
  else
    newargs+=("$a")
  fi
  prev="$a"
done
exec "$REAL" "${newargs[@]}"
