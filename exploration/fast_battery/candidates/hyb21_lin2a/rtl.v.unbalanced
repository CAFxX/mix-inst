// hyb21_lin2a: batch-21d proxy-guided 5-stage 1-AND+2-linear schedule (triage z=2.38)
module hyb21_lin2a(
    input  [63:0] val,
    input  [63:0] key,
    output [63:0] out
);
    wire [63:0] x0 = val ^ key;
    wire [63:0] x1 = x0 ^ ({x0[52:0], x0[63:53]} & {x0[0:0], x0[63:1]}) ^ {x0[45:0], x0[63:46]} ^ {x0[11:0], x0[63:12]};
    wire [63:0] x2 = x1 ^ ({x1[38:0], x1[63:39]} & {x1[55:0], x1[63:56]}) ^ {x1[43:0], x1[63:44]} ^ {x1[12:0], x1[63:13]};
    wire [63:0] x3 = x2 ^ ({x2[58:0], x2[63:59]} & {x2[32:0], x2[63:33]}) ^ {x2[49:0], x2[63:50]} ^ {x2[29:0], x2[63:30]};
    wire [63:0] x4 = x3 ^ ({x3[13:0], x3[63:14]} & {x3[57:0], x3[63:58]}) ^ {x3[62:0], x3[63:63]} ^ {x3[9:0], x3[63:10]};
    wire [63:0] x5 = x4 ^ ({x4[49:0], x4[63:50]} & {x4[62:0], x4[63:63]}) ^ {x4[1:0], x4[63:2]} ^ {x4[24:0], x4[63:25]};
    assign out = x5 ^ {key[50:0], key[63:51]};
endmodule
